---
layout: null
permalink: /feed.xml
sitemap: false
---
{%- include voorstellingen.html -%}
{%- assign alle = komende | concat: voorbij -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="nl">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.title | xml_escape }}</name></author>
  {%- for v in alle limit: 20 %}
  <entry>
    <title>{{ v.title | xml_escape }}, {% include datum.html d=v.datum %}</title>
    <link href="{{ v.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ v.url | absolute_url | xml_escape }}</id>
    <updated>{{ v.datum | date_to_xmlschema }}</updated>
    <summary type="html">{{ v.kort | default: v.excerpt | strip_html | strip | xml_escape }}</summary>
    {%- if v.affiche %}
    <link rel="enclosure" href="{{ v.affiche | absolute_url }}" type="image/webp"/>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
